<Window x:Class="FileToGitHub.RepositoryToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Repository tools" Height="590" Width="760" MinHeight="480" MinWidth="620"
        WindowStartupLocation="CenterOwner" Background="#10151E" Foreground="#EEF2F8">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#1A2230"/><Setter Property="Foreground" Value="#EEF2F8"/><Setter Property="BorderBrush" Value="#344256"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,8,8"/></Style>
        <Style TargetType="Button"><Setter Property="Background" Value="#253348"/><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="BorderBrush" Value="#3B4D66"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,4,8,8"/></Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="#141C28"/><Setter Property="Foreground" Value="#EEF2F8"/><Setter Property="BorderBrush" Value="#344256"/></Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Choose a repository folder" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="RepositoryBox" Grid.Column="0" ToolTip="owner/repository"/>
            <TextBox x:Name="BranchInput" Grid.Column="1" Text="main" ToolTip="Branch"/>
            <Button Grid.Column="2" Content="Load repository" Click="LoadRepository_Click"/>
        </Grid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="FilterBox" Grid.Column="0" ToolTip="Filter recent repositories" TextChanged="FilterBox_TextChanged"/>
            <Button Grid.Column="1" Content="Check GitHub" Click="CheckConnection_Click"/>
            <Button Grid.Column="2" Content="Refresh" Click="Refresh_Click"/>
        </Grid>
        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"><TextBlock Text="Recent repositories" Margin="0,0,0,6"/><ListBox x:Name="RecentList" SelectionChanged="RecentList_SelectionChanged"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock x:Name="FolderHeading" Text="Repository root" Margin="0,0,0,6"/><ListBox x:Name="FolderList" MouseDoubleClick="FolderList_MouseDoubleClick"/></StackPanel>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="4" Text="Select a repository, then browse folders." TextWrapping="Wrap" Foreground="#A9B9CE" Margin="0,12,0,6"/>
        <DockPanel Grid.Row="5"><TextBox x:Name="PathInput" DockPanel.Dock="Left" Margin="0,4,12,8" ToolTip="Upload folder inside repository"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Use this folder" Click="Accept_Click"/><Button Content="Cancel" Click="Cancel_Click"/></StackPanel></DockPanel>
    </Grid>
</Window>
