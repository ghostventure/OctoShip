<Window x:Class="FileToGitHub.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="300" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Topmost="True">
    <Border CornerRadius="18" BorderBrush="#3d5877" BorderThickness="1" Background="#0b1020">
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#101d34" Offset="0"/><GradientStop Color="#0b1020" Offset="0.72"/><GradientStop Color="#171127" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse Width="230" Height="230" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-125,-75,0" Fill="#163b5260"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Width="92" Height="92" Source="{StaticResource OctoShipLogoMark}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                <TextBlock Text="OCTOSHIP FOR GITHUB" Foreground="#f1f7ff" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                <ProgressBar Width="112" Height="3" IsIndeterminate="True" Margin="0,25,0,0" Foreground="#57def5" Background="#26344b" BorderThickness="0"/>
            </StackPanel>
            <TextBlock Text="GITHUB FILE TRANSFER" Foreground="#7386a3" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,17"/>
        </Grid>
    </Border>
</Window>
