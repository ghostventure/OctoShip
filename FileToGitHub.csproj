<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>OctoShip</AssemblyName>
    <Product>OctoShip for GitHub</Product>
    <Version>1.6.1-preview.10</Version>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RollForward>LatestPatch</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="verification\**\*.cs" />
    <EmbeddedResource Remove="verification\**\*" />
    <None Remove="verification\**\bin\**;verification\**\obj\**" />
  </ItemGroup>

</Project>
