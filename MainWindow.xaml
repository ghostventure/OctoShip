<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FileToGitHub.MainWindow" Title="OctoShip for GitHub" Height="880" Width="1280" MinHeight="720" MinWidth="1060" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
<Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <StackPanel>
                <WrapPanel x:Name="AppNavigation">
                    <Button Content="Files" Click="BackToSearch_Click" ToolTip="Find and review local files" />
                    <Button Content="Uploads" Click="ShippingWorkbench_Click" ToolTip="Review and ship a project" />
                    <Button Content="Repositories" Click="NavigateRepositories_Click" />
                    <Button Content="Releases" Click="ReleasePublisher_Click" />
                    <Button Content="Activity" Click="NavigateActivity_Click" />
                    <Button Content="Account &amp; settings" Click="NavigateAccount_Click" />
                </WrapPanel>
                <TextBlock x:Name="NavigationContext" Text="Account: not connected   ·   No repository selected" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch" Visibility="{Binding Visibility, ElementName=HomeView}">
        <Grid x:Name="HomeView" Margin="20,14,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <WrapPanel x:Name="HeaderActions" DockPanel.Dock="Right" MaxWidth="750" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionLabel" Text="Version 1.0.0" Foreground="#8FA0B8" FontSize="10" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Button Content="Prepare &amp; inspect" Padding="10,9" Margin="0,0,6,0" FontSize="12" Click="ShippingPreparation_Click" />
                        <Button Content="Ship project &amp; delivery checks" Padding="10,9" Margin="0,0,6,0" FontSize="12" Click="ShippingWorkbench_Click" />
                        <Button Content="Settings &amp; tools" Padding="14,9" Margin="0" FontSize="12" Click="ShowToolsPage_Click" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="52" Height="52" Source="{StaticResource OctoShipLogoMark}" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="OctoShip" FontSize="25" FontWeight="SemiBold" />
                            <TextBlock Text="Find local files. Review changes. Ship to GitHub." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <DockPanel x:Name="AccountStrip" LastChildFill="True">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <ComboBox x:Name="AccountPicker" Width="132" ToolTip="Choose a saved GitHub account" SelectionChanged="AccountPicker_SelectionChanged" Margin="0,0,8,0" />
                            <Button x:Name="ConnectButton" Content="Connect" Padding="11,7" Click="Connect_Click" Margin="0,0,8,0" />
                            <Button x:Name="AddAccountButton" Content="Add account" Padding="11,7" Margin="0,0,8,0" Click="AddAccount_Click" />
                            <Button x:Name="SignOutButton" Content="Sign out" Padding="4,2" Margin="0,0,8,0" BorderThickness="0" Background="Transparent" Foreground="#93A3B9" FontSize="10" Click="SignOut_Click" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="AccountLabel" Text="Connect a GitHub account" Foreground="#AAB8CB" FontSize="11" />
                            <CheckBox x:Name="AutoConnectCheckBox" Content="Automatically connect this account when OctoShip starts" IsChecked="False" IsEnabled="False" FontSize="10" Foreground="#AAB8CB" Margin="0,4,0,0" ToolTip="Uses the GitHub login already saved in Git Credential Manager. OctoShip does not save your password or token." Checked="AutoConnect_Changed" Unchecked="AutoConnect_Changed" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="1" MinHeight="500">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="390" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Button x:Name="ClearFiltersButton" DockPanel.Dock="Right" Content="Reset filters" Padding="9,5" FontSize="10" Margin="0" Click="ClearFilters_Click" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="7" Background="#1B3A46">
                                        <TextBlock Text="1" Foreground="#60D7D1" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="  Find files" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                            <Grid Grid.Row="1" Margin="0,11,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FolderBox" Text="Choose a folder to search…" ToolTip="Paste a folder path or browse to choose one" />
                                <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse folders" Margin="8,0,0,0" Click="Browse_Click" />
                            </Grid>
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="SearchBox" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" ToolTip="Search filenames or enter a query" KeyDown="SearchBox_KeyDown" />
                                <Button x:Name="SearchButton" Grid.Column="1" Content="Search files" Background="#174550" BorderBrush="#2D7F83" Margin="8,0,0,0" Click="Search_Click" />
                                <Button x:Name="CancelSearchButton" Grid.Column="2" Content="Cancel" Padding="10,8" Margin="7,0,0,0" Visibility="Collapsed" Click="CancelSearch_Click" />
                            </Grid>
                            <ToggleButton x:Name="FilterToggleButton" Grid.Row="3" Content="Search filters" HorizontalAlignment="Left" Padding="0" Margin="0,9,0,0" BorderThickness="0" Background="Transparent" Foreground="#64CEC9" FontSize="11" IsChecked="{Binding IsOpen, ElementName=FiltersPopup, Mode=TwoWay}" Focusable="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0,4">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#B3FFF5" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Foreground" Value="#B3FFF5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="FiltersPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=FilterToggleButton}" AllowsTransparency="True" StaysOpen="False" VerticalOffset="8">
                                <Border Background="#121B2B" BorderBrush="#3E536A" BorderThickness="1" CornerRadius="8" Padding="16" Width="550">
                                    <Grid x:Name="AdvancedFiltersPanel" Visibility="Visible" Margin="0">
                                        <ScrollViewer MaxHeight="245" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <WrapPanel>
                                                <StackPanel Margin="0,0,12,12" Width="150">
                                                    <TextBlock Text="MATCH TYPE" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5" />
                                                    <ComboBox x:Name="SearchModePicker" SelectionChanged="SearchModePicker_SelectionChanged" ToolTip="Content search reads files up to 2 MiB each">
                                                        <ComboBoxItem Content="File name" />
                                                        <ComboBoxItem Content="Regular expression" />
                                                        <ComboBoxItem Content="File contents" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,12" Width="150">
                                                    <TextBlock Text="NAME MATCH" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5" />
                                                    <CheckBox x:Name="ExactMatchCheck" Content="Exact name" Margin="0,1,0,4" />
                                                    <CheckBox x:Name="CaseSensitiveCheck" Content="Case sensitive" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,12" Width="150">
                                                    <TextBlock Text="SCOPE" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5" />
                                                    <CheckBox x:Name="RecursiveCheck" Content="Include subfolders" IsChecked="True" Margin="0,1,0,4" />
                                                    <CheckBox x:Name="IncludeHiddenCheck" Content="Include hidden" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,12" Width="150">
                                                    <TextBlock Text="FILE TYPE" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5" />
                                                    <TextBox x:Name="ExtensionFilterBox" Padding="8,6" ToolTip="Comma-separated, e.g. .pdf,.docx" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,12" Width="150">
                                                    <TextBlock Text="SKIP FOLDERS" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5" />
                                                    <TextBox x:Name="ExcludedFoldersBox" Padding="8,6" ToolTip="Comma-separated folder names" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,12" Width="150">
                                                    <TextBlock Text="MINIMUM SIZE (MB)" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5" />
                                                    <TextBox x:Name="MinSizeBox" Padding="8,6" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,12" Width="150">
                                                    <TextBlock Text="MAXIMUM SIZE (MB)" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5" />
                                                    <TextBox x:Name="MaxSizeBox" Padding="8,6" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,12" Width="150">
                                                    <TextBlock Text="MODIFIED AFTER" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5" />
                                                    <TextBox x:Name="ModifiedAfterBox" Padding="8,6" ToolTip="YYYY-MM-DD" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,12" Width="150">
                                                    <TextBlock Text="SORT RESULTS" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5" />
                                                    <ComboBox x:Name="SortPicker">
                                                        <ComboBoxItem Content="Name A–Z" />
                                                        <ComboBoxItem Content="Largest" />
                                                        <ComboBoxItem Content="Newest" />
                                                        <ComboBoxItem Content="Oldest" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Width="150" Margin="0,0,12,12">
                                                    <TextBlock Text="RESULT LIMIT" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5" />
                                                    <ComboBox x:Name="ResultLimitPicker">
                                                        <ComboBoxItem Content="50" />
                                                        <ComboBoxItem Content="100" />
                                                        <ComboBoxItem Content="200" />
                                                        <ComboBoxItem Content="500" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </WrapPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="11" Padding="14" Grid.Row="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="2,0,2,10">
                                <TextBlock x:Name="ResultCount" Text="Choose a folder to begin" Foreground="#8FA0B8" FontSize="11" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="7" Background="#1B3A46">
                                        <TextBlock Text="2" Foreground="#60D7D1" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="  Search results" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="ResultsList" Grid.Row="1" Height="400" SelectionChanged="Results_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#E8F0FA" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding FullPath}" ToolTip="{Binding FullPath}" FontSize="11" Foreground="#91A0B7" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="#728AA3" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                                <Button x:Name="ReviewFileButton" Content="Preview / review" Padding="10,6" FontSize="11" Click="ReviewFile_Click" IsEnabled="False" Margin="0,0,6,6" Background="#174550" />
                                <Button x:Name="OpenFileButton" Content="Open" Padding="10,6" FontSize="11" Click="OpenFile_Click" IsEnabled="False" Margin="0,0,6,6" />
                                <Button x:Name="RevealFileButton" Content="Show in folder" Padding="10,6" FontSize="11" Click="RevealFile_Click" IsEnabled="False" Margin="0,0,6,6" />
                                <Button x:Name="CopyPathButton" Content="Copy path" Padding="10,6" FontSize="11" Click="CopyPath_Click" IsEnabled="False" Margin="0,0,6,6" />
                                <Button x:Name="CopyHashButton" Content="Copy SHA-256" Padding="10,6" FontSize="11" Click="CopyHash_Click" IsEnabled="False" Margin="0,0,6,6" />
                            </WrapPanel>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="18">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=ResultsList, Path=Items.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Your files appear here" FontSize="17" Foreground="#CEDBEA" HorizontalAlignment="Center" />
                                <TextBlock Text="Choose a folder, then search by name or content." FontSize="12" Foreground="#8194AE" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Text="Select a result to preview it before uploading." FontSize="11" Foreground="#657F99" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="11" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="3  /  Upload to GitHub" FontSize="16" FontWeight="SemiBold" Foreground="#E9EFF8" />
                                <TextBlock Text="Choose a destination, then review your upload." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                            <Expander Header="Saved destinations" Margin="0,0,0,14" IsExpanded="False">
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="DestinationPicker" SelectionChanged="DestinationPicker_SelectionChanged" ToolTip="Reuse a saved repository, branch, and path" />
                                    <Button x:Name="SaveDestinationButton" Grid.Column="1" Content="Save preset" Padding="9,6" Margin="7,0,0,0" FontSize="10" Click="SaveDestination_Click" />
                                </Grid>
                            </Expander>
                            <DockPanel Margin="0,0,0,6">
                                <Button x:Name="RepositoryToolsButton" Content="Browse" HorizontalAlignment="Left" Padding="8,5" Margin="0" FontSize="10" Click="RepositoryTools_Click" DockPanel.Dock="Right" />
                                <TextBlock Text="REPOSITORY" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ComboBox x:Name="RepoPicker" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" Margin="0,0,0,12" ToolTip="Choose a repository or type owner/repository" SelectionChanged="RepoPicker_SelectionChanged" />
                            <Grid Margin="0,0,0,12">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="BRANCH" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5" />
                                <TextBox x:Name="BranchBox" Text="main" TextChanged="BranchBox_TextChanged" Margin="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="COMMIT MESSAGE" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5" />
                                <TextBox x:Name="CommitMessageBox" Margin="0" Text="Upload via OctoShip" MaxLength="250" />
                            </StackPanel>
                            </Grid>
                            <TabControl x:Name="UploadModeTabs">
                                <TabItem Header="Selected file">
                                    <StackPanel>
                                        <Border Background="{DynamicResource PanelSoft}" BorderBrush="#202D41" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,11">
                                            <StackPanel>
                                                <TextBlock Text="SELECTED FILE" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5" />
                                                <TextBlock x:Name="SelectedFileLabel" Text="Select a result to review it here." Foreground="#C0CCDD" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="FILE PATH IN REPOSITORY" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5" />
                                            <TextBox x:Name="PathBox" ToolTip="For example: uploads/report.pdf" TextChanged="PathBox_TextChanged" Margin="0" />
                                        </StackPanel>
                                        <Button x:Name="UploadButton" Content="Send selected file" IsEnabled="False" Background="#174550" BorderBrush="#2D7F83" Padding="13,11" HorizontalAlignment="Stretch" Margin="0" Click="Upload_Click" />
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="Folder batch">
                                    <StackPanel Margin="0">
                                        <TextBlock Text="Upload a folder tree. OctoShip checks every destination before sending." Foreground="#91A0B7" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <TextBlock Text="DESTINATION FOLDER (OPTIONAL)" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5" />
                                        <TextBox x:Name="QueuePathBox" Margin="0,0,0,8" ToolTip="GitHub destination folder; local subfolders are preserved" />
                                        <WrapPanel>
                                            <Button x:Name="QueueFolderButton" Content="Choose local folder" Padding="9,6" FontSize="10" Click="QueueFolder_Click" Margin="0,0,6,6" />
                                            <Button x:Name="QueueRunButton" Content="Review batch" Padding="9,6" FontSize="10" IsEnabled="False" Click="QueueRunWindow_Click" Margin="0,0,6,6" Background="#174550" />
                                            <Button Content="Resume saved batch" Padding="9,6" FontSize="10" Click="ResumeBatch_Click" Margin="0,0,6,6" />
                                            <Button x:Name="QueuePauseButton" Content="Pause" Padding="9,6" FontSize="10" IsEnabled="False" Click="QueuePause_Click" Visibility="Collapsed" Margin="0,0,6,6" />
                                            <Button x:Name="QueueRetryButton" Content="Retry failed" Padding="9,6" FontSize="10" IsEnabled="False" Margin="0,0,6,6" Click="QueueRetry_Click" Visibility="Collapsed" />
                                        </WrapPanel>
                                        <TextBlock x:Name="QueueStatusLabel" Text="Choose a folder to preview its files." Foreground="#9EACC1" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,5" />
                                        <ListBox x:Name="QueueList" Height="105" Visibility="Collapsed" IsHitTestVisible="False" />
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Border Grid.Row="2" Background="#111A29" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button x:Name="CancelUploadButton" DockPanel.Dock="Right" Content="Cancel upload" Padding="9,4" Margin="8,0,0,0" Visibility="Collapsed" IsEnabled="False" FontSize="10" Click="CancelUpload_Click" />
                        <TextBlock Text="STATUS" Foreground="#60D7D1" FontWeight="Bold" FontSize="9" Margin="0,0,10,0" />
                        <TextBlock x:Name="StatusLabel" Text="Ready. Choose a folder to search." Foreground="#C0CCDD" FontSize="11" TextWrapping="Wrap" />
                    </DockPanel>
                    <ProgressBar x:Name="UploadProgress" Grid.Row="1" Height="7" Margin="0,7,0,0" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Background="#202B3E" Foreground="#50D6D0" />
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>
        <Grid x:Name="ToolsView" Grid.Row="1" Margin="22,22,22,10" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Content="Back to search" Padding="12,8" Click="BackToSearch_Click" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SETTINGS &amp; TOOLS" Foreground="#60D7D1" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="Projects, tools &amp; preferences" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock Text="Find a project or choose the tool you need." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
            <TabControl Grid.Row="1" x:Name="ToolsTabs">
                <TabItem Header="Projects">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="220" />
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <Button x:Name="GithubProjectRefreshButton" DockPanel.Dock="Right" Content="Refresh projects" Padding="10,6" Click="LoadGithubProjects_Click" />
                                        <StackPanel>
                                            <TextBlock Text="EXISTING GITHUB PROJECTS" Style="{DynamicResource FieldLabel}" />
                                            <TextBlock Text="Find one of your existing repositories and set it as the upload target." FontSize="15" FontWeight="SemiBold" Margin="0,5,0,3" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid Grid.Row="1" Margin="0,10,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="GithubProjectFilter" ToolTip="Filter by repository name or description" TextChanged="GithubProjectFilter_TextChanged" />
                                        <Button x:Name="UseGithubProjectButton" Grid.Column="1" Content="Use selected project" Padding="10,6" Margin="7,0,0,0" IsEnabled="False" Click="UseGithubProject_Click" />
                                        <Button x:Name="OpenGithubProjectButton" Grid.Column="2" Content="Open on GitHub" Padding="10,6" Margin="7,0,0,0" IsEnabled="False" Click="OpenGithubProject_Click" />
                                    </Grid>
                                    <TextBlock x:Name="GithubProjectStatus" Grid.Row="2" Text="Connect an account, then refresh to list its existing repositories." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,7" />
                                    <ListBox x:Name="GithubProjectsList" Grid.Row="3" Height="220" SelectionChanged="GithubProjectsList_SelectionChanged" ToolTip="Select an existing repository to use as the upload destination">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FullName}" Foreground="#E4ECF7" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}" Foreground="#91A0B7" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Details}" Foreground="#71839C" FontSize="9" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding VisibilityLabel}" Foreground="#60D7D1" FontSize="9" FontWeight="Bold" VerticalAlignment="Top" Margin="8,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Repository tools">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="GITHUB" Style="{DynamicResource FieldLabel}" />
                                    <TextBlock Text="Repositories and access" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,6" />
                                    <TextBlock Text="Browse repositories and folders, check API connectivity and rate limits, then apply a repository and folder to the upload form." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16" />
                                    <Button Content="Browse repositories and folders" HorizontalAlignment="Left" Click="RepositoryTools_Click" />
                                    <Button Content="Prepare a release" HorizontalAlignment="Left" Margin="0,4,0,0" Click="ReleasePublisher_Click" />
                                    <TextBlock x:Name="ToolsAccountStatus" Text="Account status: checking" Foreground="#AAB8CB" FontSize="11" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Preferences">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="PREFERENCES" Style="{DynamicResource FieldLabel}" />
                                    <TextBlock Text="Privacy and saved choices" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,6" />
                                    <TextBlock Text="Choose an update channel, manage sensitive-file warnings, rename destination presets, clear selected histories, or import and export credential-free settings." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16" />
                                    <Button Content="Open settings editor" HorizontalAlignment="Left" Click="Settings_Click" />
                                    <Button Content="Open OctoShip data folder" HorizontalAlignment="Left" Margin="0,4,0,0" Click="OpenDataFolder_Click" />
                                    <TextBlock Text="GitHub credentials are not included in settings exports." Foreground="#72839A" TextWrapping="Wrap" FontSize="10" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="READ ONLY" Foreground="#60D7D1" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Text="USER PROFILE" Style="{DynamicResource FieldLabel}" />
                                            <TextBlock Text="Current OctoShip profile" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,3" />
                                            <TextBlock Text="This profile summarizes the current account and app preferences. Change them using the account controls or settings editor." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="GITHUB ACCOUNT" Style="{DynamicResource FieldLabel}" />
                                            <TextBlock x:Name="ProfileAccount" Text="Not connected" Foreground="#E4ECF7" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="CURRENT REPOSITORY" Style="{DynamicResource FieldLabel}" />
                                            <TextBlock x:Name="ProfileRepository" Text="Not selected" Foreground="#E4ECF7" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                            <TextBlock Text="UPDATE CHANNEL" Style="{DynamicResource FieldLabel}" />
                                            <TextBlock x:Name="ProfileChannel" Text="Stable" Foreground="#E4ECF7" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="PRIVACY MODE" Style="{DynamicResource FieldLabel}" />
                                            <TextBlock x:Name="ProfilePrivacy" Text="Off" Foreground="#E4ECF7" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Least-privilege guide for fine-grained tokens: browsing needs Metadata read and Contents read; uploading reviewed files needs Contents write; creating pull requests needs Pull requests write (and Contents write for the source branch); creating releases needs Contents write. Adding workflow files to a release may also require Workflows write. Grant only the permissions for workflows you use. Organization rules still apply, and OctoShip does not broaden GitHub access." Foreground="#A9B8CF" TextWrapping="Wrap" FontSize="10" Margin="0,12,0,0" />
                                    <TextBlock Text="Choose whether OctoShip asks for Windows authentication after inactivity. Windows still controls access to your signed-in computer." Foreground="#A9B8CF" TextWrapping="Wrap" Margin="0,16,0,6" />
                                    <CheckBox x:Name="RequireWindowsAuthenticationCheckBox" Content="Require Windows authentication after 30 minutes of inactivity" IsChecked="True" FontSize="11" Margin="0,0,0,8" ToolTip="When off, OctoShip skips its own inactivity prompt. Your Windows account lock remains in effect." Checked="RequireWindowsAuthentication_Changed" Unchecked="RequireWindowsAuthentication_Changed" />
                                    <Button Content="Lock account workspace now" HorizontalAlignment="Left" Click="LockAccount_Click" AutomationProperties.Name="Lock the OctoShip account workspace now" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Updates &amp; diagnostics">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="APP HEALTH" Style="{DynamicResource FieldLabel}" />
                                    <TextBlock Text="Updates and diagnostics" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,6" />
                                    <TextBlock Text="Check the configured release channel, verify the current Windows/runtime compatibility, or copy a privacy-safe diagnostic summary." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16" />
                                    <Button Content="Check for updates" HorizontalAlignment="Left" Click="Update_Click" x:Name="UpdateButton" />
                                    <Button Content="Run compatibility check" HorizontalAlignment="Left" Margin="0,4,0,0" Click="CheckCompatibility_Click" />
                                    <Button x:Name="StartupHealthButton" Content="Run account and startup readiness check" HorizontalAlignment="Left" Margin="0,4,0,0" Click="RunStartupHealthCheck_Click" />
                                    <Button Content="Copy diagnostics" HorizontalAlignment="Left" Margin="0,4,0,0" Click="CopyDiagnostics_Click" />
                                    <TextBlock x:Name="NetworkStatus" Text="Network type: not checked" Foreground="#AAB8CB" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0" />
                                    <ProgressBar x:Name="UpdateDownloadProgress" Height="7" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Margin="0,9,0,0" Background="#202B3E" Foreground="#50D6D0" />
                                    <TextBlock x:Name="UpdateDownloadStatus" Foreground="#91A0B7" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock x:Name="CompatibilityStatus" Text="Compatibility has not been checked this session." Foreground="#72839A" TextWrapping="Wrap" FontSize="10" Margin="0,12,0,0" />
                                    <TextBlock x:Name="StartupHealthStatus" Text="Readiness has not been checked this session." Foreground="#72839A" TextWrapping="Wrap" FontSize="10" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <Border Grid.Row="2" Background="#111A29" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="0,14,0,0">
                <DockPanel>
                    <TextBlock x:Name="ToolsVersionLabel" DockPanel.Dock="Right" Foreground="#72839A" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Text="Updates are verified by SHA-256 before installation. Publisher-signature verification requires a signed release." Foreground="#AAB8CB" FontSize="10" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </Grid>
        <Expander x:Name="TerminalExpander" Grid.Row="2" Header="Transfer activity" IsExpanded="False" Margin="20,0,20,12" Foreground="#DCE7F5" FontSize="11" FontWeight="SemiBold">
            <Border Background="#080D16" BorderBrush="#26354A" BorderThickness="1" CornerRadius="7" Padding="8" Margin="0,5,0,0">
                <TextBox x:Name="TransferTerminal" Height="100" IsReadOnly="True" IsReadOnlyCaretVisible="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10" Foreground="#B9D7C8" Background="#080D16" BorderThickness="0" Padding="2" />
            </Border>
        </Expander>
    </Grid>
</Window>
