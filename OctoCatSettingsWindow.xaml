<Window x:Class="FileToGitHub.OctoCatSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FileToGitHub"
        Title="OctoShip for GitHub settings" Height="700" Width="760" MinHeight="580" MinWidth="640"
        WindowStartupLocation="CenterOwner" Background="#10151E" Foreground="#EEF2F8">
<Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Settings and privacy" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <TextBox x:Name="SettingsSearchBox" ToolTip="Search settings" TextChanged="SettingsSearch_TextChanged" Margin="0,0,0,12"/>
                <GroupBox x:Name="WorkspaceHealthGroup" Header="Workspace health and archive" Foreground="#DCE6F4" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <Button Content="Inspect local workspace health" HorizontalAlignment="Left" Click="HealthReport_Click"/>
                        <TextBox x:Name="HealthReportText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="100" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="Archive labels hide inactive workspaces from archive-aware tools. Existing workspaces are read-only only where the consuming workflow honors this policy." TextWrapping="Wrap" Foreground="#A9B9CE" Margin="0,6,0,4"/>
                        <DockPanel><TextBox x:Name="ArchiveWorkspaceInput" DockPanel.Dock="Left" ToolTip="Workspace name to archive"/><Button Content="Archive" Click="ArchiveWorkspace_Click"/><Button Content="Restore selected" Click="RestoreWorkspace_Click"/></DockPanel>
                        <ListBox x:Name="ArchivedWorkspaceList" Height="80"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="PrivacyPolicyGroup" Header="Privacy and project policies" Foreground="#DCE6F4" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="ScreenShareMaskCheck" Content="Enable screen-sharing privacy mask preference"/>
                        <TextBlock Text="This preference is stored locally; live-window redaction is controlled by the app workflow integration." TextWrapping="Wrap" Foreground="#A9B9CE"/>
                        <TextBlock Text="Repositories that must remain private (owner/name)" Foreground="#A9B9CE" Margin="0,8,0,0"/>
                        <DockPanel><TextBox x:Name="PrivateRepositoryInput" DockPanel.Dock="Left" ToolTip="owner/repository"/><Button Content="Add rule" Click="AddPrivateRepository_Click"/></DockPanel>
                        <ListBox x:Name="PrivateRepositoryList" Height="75"/><Button Content="Remove selected rule" HorizontalAlignment="Left" Click="RemovePrivateRepository_Click"/>
                        <TextBlock Text="A publication policy is saved for workflow enforcement. Existing publication code must consult this rule before sending files." TextWrapping="Wrap" Foreground="#A9B9CE"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="RetentionRepairGroup" Header="Local data retention and profile repair" Foreground="#DCE6F4" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Preview eligible local data. Account settings.json is protected because it can contain sign-in state." TextWrapping="Wrap" Foreground="#A9B9CE"/>
                        <Button Content="Refresh retention preview" HorizontalAlignment="Left" Click="RefreshRetention_Click"/>
                        <ListBox x:Name="RetentionList" Height="90" SelectionMode="Extended"/>
                        <Button Content="Purge selected local data" HorizontalAlignment="Left" Click="PurgeRetention_Click"/>
                        <Button Content="Repair preference profile" HorizontalAlignment="Left" Click="RepairProfile_Click"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="ChangeReviewGroup" Header="Pending changes" Foreground="#DCE6F4" Padding="12" Margin="0,0,0,12">
                    <StackPanel><Button Content="Preview pending changes" HorizontalAlignment="Left" Click="PreviewChanges_Click"/><TextBlock x:Name="PendingChangesText" TextWrapping="Wrap" Foreground="#A9B9CE"/><WrapPanel><Button Content="Reset privacy section" Click="ResetPrivacy_Click"/><Button Content="Reset update section" Click="ResetUpdates_Click"/><Button Content="Reset history section" Click="ResetHistory_Click"/><Button Content="Reset patterns" Click="ResetPatterns_Click"/><Button Content="Reset destinations" Click="ResetDestinations_Click"/></WrapPanel></StackPanel>
                </GroupBox>
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16"><local:AppearanceControls /></Border>
                <GroupBox x:Name="PrivacyUpdatesGroup" Header="Privacy and update channel" Foreground="#DCE6F4" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="PrivacyCheck" Content="Privacy Mode: do not retain search terms, recent repositories, or local upload paths"/>
                        <TextBlock Text="Clipboard copies" Foreground="#A9B9CE" Margin="0,8,0,0"/>
                        <ComboBox x:Name="ClipboardClearPicker" Width="190" HorizontalAlignment="Left" SelectedIndex="0">
                            <ComboBoxItem Content="Keep copied text"/><ComboBoxItem Content="Clear after 30 seconds"/><ComboBoxItem Content="Clear after 1 minute"/><ComboBoxItem Content="Clear after 5 minutes"/>
                        </ComboBox>
                        <TextBlock Text="When enabled, OctoShip clears its copied path, hash, or diagnostics only if that exact text is still on the clipboard when the timer expires." TextWrapping="Wrap" Foreground="#A9B9CE"/>
                        <CheckBox x:Name="AutomaticUpdatesCheck" Content="Automatically download updates and install when OctoShip closes"/>
                        <TextBlock Text="Checks public GitHub releases at startup and every two minutes while unlocked. No GitHub sign-in is needed for updates. Preview also receives stable releases." TextWrapping="Wrap"/>
                        <TextBlock Text="Update channel" Foreground="#A9B9CE"/>
                        <ComboBox x:Name="ChannelPicker" SelectedIndex="0" Width="180" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <ComboBoxItem Content="Stable"/><ComboBoxItem Content="Preview"/>
                        </ComboBox>
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="ClearHistoryGroup" Header="Clear saved history" Foreground="#DCE6F4" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <WrapPanel><CheckBox x:Name="ClearSearchCheck" Content="Search history"/><CheckBox x:Name="ClearRecentCheck" Content="Recent repositories"/><CheckBox x:Name="ClearDestinationsCheck" Content="Destination presets"/></WrapPanel>
                        <Button Content="Clear selected history" HorizontalAlignment="Left" Click="ClearHistory_Click"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="DestinationPresetsGroup" Header="Saved destination presets" Foreground="#DCE6F4" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Rename a preset label or delete it. Its repository, branch, and upload path stay intact." Foreground="#A9B9CE" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ListBox x:Name="PresetList" Height="110" DisplayMemberPath="Label" SelectionChanged="PresetList_SelectionChanged"/>
                        <DockPanel><TextBox x:Name="PresetNameInput" DockPanel.Dock="Left" ToolTip="Preset display name"/><Button Content="Rename label" Click="RenamePreset_Click"/></DockPanel>
                        <Button Content="Delete selected preset" HorizontalAlignment="Left" Click="DeletePreset_Click"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="SensitivePatternsGroup" Header="Sensitive filename patterns" Foreground="#DCE6F4" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Add glob patterns such as *.pem or **/.env. These add warnings; they do not block uploads." Foreground="#A9B9CE" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <DockPanel><TextBox x:Name="PatternInput" DockPanel.Dock="Left" ToolTip="Glob pattern" TextChanged="PatternInput_TextChanged"/><Button Content="Add pattern" Click="AddPattern_Click"/></DockPanel>
                        <TextBlock x:Name="PatternValidationText" TextWrapping="Wrap" Foreground="OrangeRed" Visibility="Collapsed" Margin="0,4,0,0"/>
                        <ListBox x:Name="PatternList" Height="105"/>
                        <Button Content="Remove selected pattern" HorizontalAlignment="Left" Click="RemovePattern_Click"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="PublisherSignatureGroup" Header="Publisher signature verification" Foreground="#DCE6F4" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Checks Windows Authenticode trust for a selected executable. OctoShip for GitHub needs a trusted code-signing certificate; unsigned builds will be reported as unsigned." Foreground="#A9B9CE" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="Optional expected publisher thumbprint (pinning)" Foreground="#A9B9CE"/>
                        <TextBox x:Name="ThumbprintInput" ToolTip="Expected signer thumbprint"/>
                        <Button Content="Choose EXE and verify" HorizontalAlignment="Left" Click="VerifyPublisher_Click"/>
                        <TextBlock x:Name="SignatureStatus" Text="No file checked." TextWrapping="Wrap" Foreground="#A9B9CE"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="SettingsTransferGroup" Header="Credential-free settings transfer" Foreground="#DCE6F4" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Versioned imports migrate supported settings packages. Exports include preferences, histories, and sensitive filename rules. Account credentials and local machine paths are never included." Foreground="#A9B9CE" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <WrapPanel><Button Content="Import settings" Click="Import_Click"/><Button Content="Export settings" Click="Export_Click"/></WrapPanel>
                    </StackPanel>
                </GroupBox>
                <TextBlock x:Name="StatusText" Text="Changes apply when you select Save." Foreground="#A9B9CE" TextWrapping="Wrap" Margin="0,12,0,4"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Click="Save_Click"/><Button Content="Cancel" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
