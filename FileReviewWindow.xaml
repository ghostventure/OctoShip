<Window x:Class="FileToGitHub.FileReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review file" Height="690" Width="940" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="#0B1020" Foreground="#E9EFF8">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="FileTitle" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="FileDetails" Foreground="#91A0B7" Margin="0,5,0,0"/>
            <Border x:Name="WarningCard" Visibility="Collapsed" Background="#422B1B" BorderBrush="#B77B3B" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,12,0,0">
                <StackPanel><TextBlock Text="Review warning" FontWeight="Bold" Foreground="#FFD39C"/><TextBlock x:Name="WarningText" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
            </Border>
        </StackPanel>
        <TabControl Grid.Row="1" Background="#121B2B" BorderBrush="#26354A">
            <TabItem Header="Preview"><Grid Margin="10"><TextBlock x:Name="PreviewMessage" TextWrapping="Wrap" Foreground="#BCC8D9" VerticalAlignment="Center" HorizontalAlignment="Center"/><Image x:Name="ImagePreview" Stretch="Uniform" Visibility="Collapsed"/><Button x:Name="OpenPdfButton" Content="Open PDF in default viewer" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Click="OpenPdf_Click"/></Grid></TabItem>
            <TabItem Header="Compare with GitHub"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,8"><TextBlock x:Name="CompareStatus" Text="Remote comparison is available for text files." VerticalAlignment="Center" Foreground="#91A0B7"/><Button x:Name="CompareButton" Content="Load remote version" DockPanel.Dock="Right" Click="Compare_Click"/></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="LocalText" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/><TextBox x:Name="RemoteText" Grid.Column="1" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="8,0,0,0"/></Grid></Grid></TabItem>
        </TabControl>
        <DockPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="Local preview stays on this device. Review warnings before uploading." Foreground="#91A0B7" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Close" IsCancel="True"/><Button Content="Continue to upload" Background="#155B5C" Click="Continue_Click"/></StackPanel></DockPanel>
    </Grid>
</Window>
